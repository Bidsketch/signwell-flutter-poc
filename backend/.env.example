# Copy to backend/.env and fill in. Never put the API key in the Flutter app.

# SignWell API key: SignWell > Settings > API.
SIGNWELL_API_KEY=

# true = test documents (free, watermarked, not legally binding). Set false for production.
SIGNWELL_TEST_MODE=true

# Optional: use a SignWell template instead of the bundled sample PDF.
# The placeholder is the template's recipient placeholder name.
SIGNWELL_TEMPLATE_ID=
SIGNWELL_TEMPLATE_PLACEHOLDER=Signer

# Optional: webhook ID used to verify webhook events (from POST/GET /api/v1/hooks).
SIGNWELL_WEBHOOK_ID=

PORT=8080
